# ── Smart Campus 360 — Backend Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/smartcampus360
# Atlas:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smartcampus360?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/smartcampus360

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret_string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL (used for production CORS whitelist)
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
