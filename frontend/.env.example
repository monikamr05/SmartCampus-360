# ── Smart Campus 360 — Frontend Environment Variables ─────────────────────────
# Copy this file to .env.local and fill in your values.
# Vite exposes only variables prefixed with VITE_ to the browser.

# ── API Base URL ──────────────────────────────────────────────────────────────
# In development this is handled by vite.config.js proxy — leave empty.
# In production set to your Render backend URL:
# VITE_API_BASE_URL=https://smartcampus-backend.onrender.com
VITE_API_BASE_URL=
